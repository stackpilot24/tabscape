{
  "manifest_version": 3,
  "name": "Customizable TAB",
  "version": "1.2.0",
  "description": "A minimal, customizable new tab dashboard with deep links, live 3D wallpapers, daily photos and widgets.",
  "chrome_url_overrides": { "newtab": "newtab.html" },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "permissions": ["storage", "unlimitedStorage", "geolocation"],
  "host_permissions": ["https://www.bing.com/*"],
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
}
